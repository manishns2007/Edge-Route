# ===================================================
# EdgeRoute — .env.example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ===================================================

# --- Ollama / SLM ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_TIMEOUT=60

# --- Router / Policy ---
SLM_CONFIDENCE_THRESHOLD=0.70
COMPLEXITY_THRESHOLD=0.70
COMPLEXITY_WORD_THRESHOLD=60

# --- Cloud Adapter ---
# Set MOCK_CLOUD=false to use a real cloud LLM
MOCK_CLOUD=true
CLOUD_API_KEY=
CLOUD_MODEL=gpt-4o-mini
CLOUD_API_BASE=https://api.openai.com/v1

# --- Dry-run mode (skips live generation for non-classification steps) ---
DRY_RUN=false

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Logging ---
LOG_LEVEL=INFO
DEBUG=false
